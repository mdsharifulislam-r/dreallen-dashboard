# Backend API origin from the Postman collection variable {{URL}}
# Collection value: http://localhost:5000//api/v1 (normalized without the double slash)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Origin used to resolve relative media paths such as /cover_image/..., /audio/..., /video/...
VITE_FILE_BASE_URL=http://localhost:5000
